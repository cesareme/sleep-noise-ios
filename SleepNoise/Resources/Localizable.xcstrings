        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar el sonido."
          }
        }
      }
    },
    "siri.mezcla.cual": {
      "comment": "Siri: asks which mix when none was named or the one named is gone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of your mixes?"
