      "comment": "Shortcuts: summary of the timer action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the timer to ${mode}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el temporizador en ${mode}"
          }
        }
      }
    },
    "siri.error": {
      "comment": "Siri: the only thing a playback Shortcut says, when the sound did not start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the sound."
          }
