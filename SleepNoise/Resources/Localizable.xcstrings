    "paywall.trial.endedDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White, pink, brown, rain, wind and the whole timer stay free. Your saved mixes are kept and come back whole with Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanco, rosa, marrón, lluvia, viento y el temporizador entero siguen gratis. Tus mezclas guardadas se conservan y vuelven enteras con Pro."
          }
        }
      }
    },
