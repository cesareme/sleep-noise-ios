          "stringUnit": {
            "state": "translated",
            "value": "Fundiendo"
          }
        }
      }
    },
    "temporizador.cabecera.manto": {
      "comment": "Timer sheet, line under the hour of a blanket while its dip is still to come: the minutes after which the level eases down.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eases down after %lld min"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja un poco a los %lld min"
          }
        }
      }
