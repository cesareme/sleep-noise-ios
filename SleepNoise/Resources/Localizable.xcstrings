    "paywall.trial.notStartedFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %lld days start at the first Play. Afterwards white, pink, brown, rain, wind and the whole timer stay free, and the mixes you saved are kept; saving more needs Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus %lld días empiezan al primer Reproducir. Después seguirán gratis blanco, rosa, marrón, lluvia, viento y el temporizador entero, y las mezclas que guardaste se conservan; guardar más necesita Pro."
          }
        }
      }
    },
    "paywall.trial.endedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial over. Free stays free."
          }
