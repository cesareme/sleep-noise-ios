    },
    "Play ${mix}": {
      "comment": "Shortcuts: summary of the action that plays a mix.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play ${mix}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon ${mix}"
          }
        }
      }
    },
