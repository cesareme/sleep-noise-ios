    "paywall.trial.activeFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Last day. Afterwards white, pink, brown, rain, wind and the whole timer stay free, and the mixes you saved are kept; saving more needs Pro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days left. Afterwards white, pink, brown, rain, wind and the whole timer stay free, and the mixes you saved are kept; saving more needs Pro."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Último día. Después seguirán gratis blanco, rosa, marrón, lluvia, viento y el temporizador entero, y las mezclas que guardaste se conservan; guardar más necesita Pro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Quedan %lld días. Después seguirán gratis blanco, rosa, marrón, lluvia, viento y el temporizador entero, y las mezclas que guardaste se conservan; guardar más necesita Pro."
                }
              }
            }
          }
        }
      }
    },
