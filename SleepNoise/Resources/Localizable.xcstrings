    "marea.instruccion": {
      "comment": "Tide sheet: the one sentence there is to know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in as the wave rises, out as it pulls back. No need to watch the screen."
